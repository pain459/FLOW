FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 USE_TF=0 USE_TORCH=1 TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=2 TORCH_DISABLE_NATIVE_JIT=1 HF_HOME=/cache HF_HUB_OFFLINE=1
COPY decision_engine/requirements.model.lock /requirements.lock
RUN pip install --no-cache-dir -r /requirements.lock
RUN pip install --no-deps --no-cache-dir torch==2.14.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-deps --no-cache-dir 'https://files.pythonhosted.org/packages/18/95/48f65be695b72a4dc04fdda78cf84951ed58cf90e66d1d1d2062b1908bd0/laya-0.4.3-py3-none-any.whl#sha256=1cd9c33ab0b2b12f0122e6bf643fb4ead70309983ffb68f8db854d7a8f412d50'
RUN pip check && groupadd -g 10001 decision && useradd -u 10001 -g decision -m decision && mkdir /cache && chown decision:decision /cache
WORKDIR /app
COPY decision_engine/__init__.py decision_engine/model_service.py decision_engine/provision.py decision_engine/http_limits.py decision_engine/checkpoint.py decision_engine/inference_input.py /app/decision_engine/
COPY decision_engine/models /app/decision_engine/models
COPY decision_engine/questions /app/decision_engine/questions
COPY chaos/observation_contract.py /app/chaos/observation_contract.py
USER decision
CMD ["uvicorn", "decision_engine.model_service:app", "--host", "0.0.0.0", "--port", "8010", "--no-access-log", "--limit-concurrency", "4"]
