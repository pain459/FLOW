{
  "uid": "pulsepay-load-capacity",
  "title": "PulsePay — Load & Capacity",
  "schemaVersion": 40,
  "version": 1,
  "tags": [
    "pulsepay",
    "load"
  ],
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Run state",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "expr": "changes(load_run_status[15s]) > 0",
        "iconColor": "#F2CC0C",
        "step": "5s",
        "tagKeys": "profile",
        "titleFormat": "Workload phase change"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Active and configured users",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "load_active_users",
          "refId": "A",
          "legendFormat": "{{operation}} {{status_class}} {{outcome}} {{result}} {{service}}"
        },
        {
          "expr": "load_target_users",
          "refId": "B",
          "legendFormat": "{{operation}} {{status_class}} {{outcome}} {{result}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Achieved HTTP requests/sec",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "load_measured_rps",
          "refId": "A",
          "legendFormat": "{{operation}} {{status_class}} {{outcome}} {{result}} {{service}}"
        },
        {
          "expr": "sum(rate(load_requests_total{phase=\"measured\"}[30s]))",
          "refId": "B",
          "legendFormat": "{{operation}} {{status_class}} {{outcome}} {{result}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Read versus write HTTP RPS",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(load_requests_total{phase=\"measured\",operation=~\".*_read|transfer_status\"}[30s]))",
          "refId": "A",
          "legendFormat": "{{operation}} {{status_class}} {{outcome}} {{result}} {{service}}"
        },
        {
          "expr": "sum(rate(load_requests_total{phase=\"measured\",operation=\"transfer_write\"}[30s]))",
          "refId": "B",
          "legendFormat": "{{operation}} {{status_class}} {{outcome}} {{result}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Actual HTTP mix and configured logical weights",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by(operation)(rate(load_requests_total{phase=\"measured\"}[30s])) / scalar(sum(rate(load_requests_total{phase=\"measured\"}[30s])))",
          "refId": "A",
          "legendFormat": "HTTP {{operation}}"
        },
        {
          "expr": "load_configured_operation_weight",
          "refId": "B",
          "legendFormat": "Configured {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Infrastructure errors and timeouts/sec",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by(outcome)(rate(load_outcome_requests_total{phase=\"measured\",outcome=~\"infrastructure_failure|timeout|contract_error\"}[30s]))",
          "refId": "A",
          "legendFormat": "{{operation}} {{status_class}} {{outcome}} {{result}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "HTTP latency p50/p95/p99 seconds",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5,sum by(le)(rate(load_request_duration_seconds_bucket{phase=\"measured\"}[30s])))",
          "refId": "A",
          "legendFormat": "{{operation}} {{status_class}} {{outcome}} {{result}} {{service}}"
        },
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(load_request_duration_seconds_bucket{phase=\"measured\"}[30s])))",
          "refId": "B",
          "legendFormat": "{{operation}} {{status_class}} {{outcome}} {{result}} {{service}}"
        },
        {
          "expr": "histogram_quantile(0.99,sum by(le)(rate(load_request_duration_seconds_bucket{phase=\"measured\"}[30s])))",
          "refId": "C",
          "legendFormat": "{{operation}} {{status_class}} {{outcome}} {{result}} {{service}}"
        }
