FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/reader
RUN groupadd -g 1001 observer && useradd -u 1001 -g observer observer
WORKDIR /reader
COPY chaos/observation_contract.py chaos/observation_feed.py ./chaos/
USER 1001:1001
ENTRYPOINT ["python", "-m", "chaos.observation_feed"]
