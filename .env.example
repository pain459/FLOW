APP_PASSWORD=replace_with_generated_secret
WORKER_PASSWORD=replace_with_generated_secret
VERIFIER_PASSWORD=replace_with_generated_secret
MIGRATOR_PASSWORD=replace_with_generated_secret
GRAFANA_PASSWORD=replace_with_generated_secret
PULSEPAY_CURRENCY=INR
API_PORT=8080
SEED_ACCOUNT_COUNT=200
SEED_BALANCE_MINOR=100000
SEED_VERSION=pulsepay-v1
DB_POOL_SIZE=8
DB_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=12
CACHE_TTL_SECONDS=5
WORKER_POLL_SECONDS=1
